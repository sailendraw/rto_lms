<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Assignment: Portal/students can view assignments in enrolled courses -->
        <record id="rule_rto_assignment_portal" model="ir.rule">
            <field name="name">Assignment - Portal (Enrolled Courses)</field>
            <field name="model_id" ref="model_rto_assignment"/>
            <field name="domain_force">[('course_id.channel_partner_ids.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Assignment: Staff can view all assignments -->
        <record id="rule_rto_assignment_staff" model="ir.rule">
            <field name="name">Assignment - Staff (All)</field>
            <field name="model_id" ref="model_rto_assignment"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('website_slides.group_website_slides_officer')), (4, ref('website_slides.group_website_slides_manager'))]"/>
        </record>

        <!-- Submission: Portal users can only access their own submissions -->
        <record id="rule_rto_assignment_submission_portal" model="ir.rule">
            <field name="name">Assignment Submission - Portal (Own Only)</field>
            <field name="model_id" ref="model_rto_assignment_submission"/>
            <field name="domain_force">[('user_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Submission: Staff can view all submissions -->
        <record id="rule_rto_assignment_submission_staff" model="ir.rule">
            <field name="name">Assignment Submission - Staff (All)</field>
            <field name="model_id" ref="model_rto_assignment_submission"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('website_slides.group_website_slides_officer')), (4, ref('website_slides.group_website_slides_manager'))]"/>
        </record>

    </data>
</odoo>
