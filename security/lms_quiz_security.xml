<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Portal users can only see their own attempts -->
        <record id="rule_lms_quiz_attempt_portal" model="ir.rule">
            <field name="name">Quiz Attempts - Portal</field>
            <field name="model_id" ref="model_lms_quiz_attempt"/>
            <field name="domain_force">[('student_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Training staff can review all attempts -->
        <record id="rule_lms_quiz_attempt_staff" model="ir.rule">
            <field name="name">Quiz Attempts - Staff</field>
            <field name="model_id" ref="model_lms_quiz_attempt"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('website_slides.group_website_slides_officer')), (4, ref('website_slides.group_website_slides_manager'))]"/>
        </record>

        <!-- Portal users restricted to their own attempt answers -->
        <record id="rule_lms_quiz_attempt_answer_portal" model="ir.rule">
            <field name="name">Quiz Attempt Answers - Portal</field>
            <field name="model_id" ref="model_lms_quiz_attempt_answer"/>
            <field name="domain_force">[('attempt_id.student_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Training staff can view all attempt answers -->
        <record id="rule_lms_quiz_attempt_answer_staff" model="ir.rule">
            <field name="name">Quiz Attempt Answers - Staff</field>
            <field name="model_id" ref="model_lms_quiz_attempt_answer"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('website_slides.group_website_slides_officer')), (4, ref('website_slides.group_website_slides_manager'))]"/>
        </record>
    </data>
</odoo>
