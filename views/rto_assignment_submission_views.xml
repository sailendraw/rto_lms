<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_rto_assignment_submission_form" model="ir.ui.view">
        <field name="name">rto.assignment.submission.form</field>
        <field name="model">rto.assignment.submission</field>
        <field name="arch" type="xml">
            <form string="Assignment Submission" create="0">
                <header>
                    <button name="action_submit" type="object" string="Submit for Grading"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_reopen" type="object" string="Allow Resubmission"
                            invisible="state != 'graded'" class="btn-secondary"
                            groups="website_slides.group_website_slides_officer,website_slides.group_website_slides_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,graded"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Late Submission" bg_color="bg-warning"
                            invisible="not is_late"/>
                    <widget name="web_ribbon" title="Passed" bg_color="bg-success"
                            invisible="not passed or state != 'graded'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="submission_reference" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="assignment_id" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Submission">
                            <field name="user_id" readonly="state != 'draft'"/>
                            <field name="attempt_number" readonly="1"/>
                            <field name="created_on" readonly="1"/>
                            <field name="submitted_on" readonly="1" invisible="state == 'draft'"/>
                        </group>
                        <group string="Grading" invisible="state != 'graded'">
                            <field name="grade"/>
                            <field name="grade_percentage" readonly="1"/>
                            <field name="passed" widget="boolean_toggle" readonly="1"/>
                            <field name="grader_id" readonly="1"/>
                            <field name="graded_on" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Submitted Files">
                            <field name="attachment_ids" widget="many2many_binary"
                                   readonly="state != 'draft'" nolabel="1"/>
                        </page>
                        <page string="Grader Feedback" invisible="state != 'graded'">
                            <field name="feedback" readonly="1"/>
                            <separator string="Feedback Attachments" invisible="not feedback_attachment_ids"/>
                            <field name="feedback_attachment_ids" widget="many2many_binary"
                                   readonly="1" nolabel="1"/>
                        </page>
                        <page string="Assessment Outcome" invisible="not outcome_id"
                              groups="website_slides.group_website_slides_officer,website_slides.group_website_slides_manager">
                            <field name="outcome_id" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_rto_assignment_submission_tree" model="ir.ui.view">
        <field name="name">rto.assignment.submission.tree</field>
        <field name="model">rto.assignment.submission</field>
        <field name="arch" type="xml">
            <list string="Submissions"
                  decoration-success="state == 'graded' and passed"
                  decoration-warning="is_late"
                  decoration-danger="state == 'graded' and not passed">
                <field name="submission_reference"/>
                <field name="assignment_id"/>
                                <field name="course_id" optional="hide"/>
                <field name="user_id"/>
                <field name="attempt_number"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'graded'"/>
                <field name="submitted_on"/>
                <field name="is_late" widget="boolean" optional="hide"/>
                <field name="grade" optional="show"/>
                <field name="passed" widget="boolean" optional="show"/>
                <field name="attachment_count" string="Files"/>
                <field name="graded_on" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_rto_assignment_submission_search" model="ir.ui.view">
        <field name="name">rto.assignment.submission.search</field>
        <field name="model">rto.assignment.submission</field>
        <field name="arch" type="xml">
            <search string="Search Submissions">
                <field name="submission_reference"/>
                <field name="assignment_id"/>
                <field name="course_id"/>
                <field name="user_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Graded" name="graded" domain="[('state', '=', 'graded')]"/>
                <separator/>
                <filter string="Passed" name="passed" domain="[('passed', '=', True)]"/>
                <filter string="Not Passed" name="not_passed" domain="[('passed', '=', False), ('state', '=', 'graded')]"/>
                <filter string="Late" name="late" domain="[('is_late', '=', True)]"/>
                <separator/>
                <filter string="My Submissions" name="my_submissions" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter string="Assignment" name="group_assignment" context="{'group_by': 'assignment_id'}"/>
                    <filter string="Course" name="group_course" context="{'group_by': 'course_id'}"/>
                    <filter string="Student" name="group_student" context="{'group_by': 'user_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_rto_assignment_submission" model="ir.actions.act_window">
        <field name="name">Assignment Submissions</field>
        <field name="res_model">rto.assignment.submission</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_submitted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No submissions yet
            </p>
            <p>
                Submissions appear here when students upload files for assignments.
            </p>
        </field>
    </record>

    <!-- Window Action Views -->
    <record id="action_rto_assignment_submission_view_list" model="ir.actions.act_window.view">
        <field name="sequence">10</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_rto_assignment_submission_tree"/>
        <field name="act_window_id" ref="action_rto_assignment_submission"/>
    </record>

    <record id="action_rto_assignment_submission_view_form" model="ir.actions.act_window.view">
        <field name="sequence">20</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_rto_assignment_submission_form"/>
        <field name="act_window_id" ref="action_rto_assignment_submission"/>
    </record>

</odoo>
